{
  "name": "resc-mcp",
  "version": "1.0.0",
  "description": "Read-only disk forensics MCP engine with native NTFS/FAT RAM-overlay validation",
  "repository": {
    "type": "git",
    "url": "https://github.com/psy-zney/resc.git"
  },
  "main": "bin/resc-mcp.js",
  "bin": {
    "resc": "./bin/resc-mcp.js",
    "resc-mcp": "./bin/resc-mcp.js",
    "recoveryai-mcp": "./bin/resc-mcp.js"
  },
  "type": "commonjs",
  "files": [
    "bin/",
    ".agents/skills/",
    "scripts/setup_clients.py",
    "scripts/install.py",
    "scripts/setup.ps1",
    "scripts/resc_cli.py",
    "scripts/mcp_server_engine.py",
    "scripts/disk_header_inspector.py",
    "scripts/driver_and_device_manager.py",
    "scripts/format_recovery_engine.py",
    "scripts/recovery.py",
    "scripts/rescue.py",
    "scripts/evidence_audit.py",
    "scripts/usb_format_verify.py",
    "scripts/usb_lab.py",
    "scripts/usb_lab.ps1",
    "README.md",
    "AGENTS.md",
    "mcp_config.example.json",
    "docs/engine-capabilities.md",
    "docs/v5-integration-review.vi.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node ./bin/resc-mcp.js",
    "setup:clients": "python scripts/setup_clients.py",
    "inspect": "npx @modelcontextprotocol/inspector node ./bin/resc-mcp.js",
    "build:rust": "cargo build --release",
    "test:e2e": "python tests/test_e2e_recovery.py"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "mcp-server",
    "data-recovery",
    "disk-forensics",
    "ntfs",
    "fat32",
    "exfat",
    "simd",
    "rust",
    "ai-agent",
    "claude",
    "cursor"
  ],
  "author": "resc contributors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
